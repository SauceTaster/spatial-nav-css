{
  "name": "spatial-nav-css-examples",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Runnable framework + real-world-library integration examples for spatial-nav-css. Each example doubles as a regression test. Kept in its own package so the root install stays lean.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.20.5",
    "@xyflow/react": "^12.3.5",
    "echarts": "^5.5.1",
    "react": "^19.0.0",
    "react-aria-components": "^1.18.0",
    "react-dom": "^19.0.0",
    "svelte": "^5.19.0",
    "tslib": "^2.8.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/svelte": "^5.2.6",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/vue": "^8.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
